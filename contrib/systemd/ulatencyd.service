[Unit]
Description=ulatencyd-rs — cgroup v2 + scheduler latency daemon
Documentation=https://github.com/example/ulatencyd-rs
After=dbus.service
Wants=dbus.service
# Start before user sessions so processes are already classified when the
# desktop launches.
Before=display-manager.service graphical.target
DefaultDependencies=no

[Service]
Type=notify
ExecStart=/usr/sbin/ulatencyd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# cgroup delegation — allow ulatencyd to manage its own sub-hierarchy.
Slice=system.slice
Delegate=yes
DelegateControllers=cpu memory io cpuset

# Security hardening.
NoNewPrivileges=no           # must setscheduler / write to /proc
AmbientCapabilities=CAP_SYS_NICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_SYS_NICE CAP_NET_ADMIN CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RuntimeDirectory=ulatencyd
RuntimeDirectoryMode=0755

# Allow writing to /proc/*/oom_score_adj.
ReadWritePaths=/proc /sys/fs/cgroup

[Install]
WantedBy=multi-user.target graphical.target
