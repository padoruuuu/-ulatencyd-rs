#!/sbin/openrc-run
# OpenRC init script for ulatencyd-rs.
#
# Install:
#   sudo cp contrib/openrc/ulatencyd /etc/init.d/ulatencyd
#   sudo chmod +x /etc/init.d/ulatencyd
#   sudo rc-update add ulatencyd default

description="ulatencyd-rs cgroup v2 + scheduler latency daemon"
command="/usr/sbin/ulatencyd"
command_background="yes"
pidfile="/run/ulatencyd.pid"
start_stop_daemon_args="--background --make-pidfile"

depend() {
    need dbus
    use logger
    after bootmisc
}

reload() {
    ebegin "Reloading ulatencyd rules"
    start-stop-daemon --signal HUP --pidfile "${pidfile}"
    eend $?
}
